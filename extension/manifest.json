{
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "commands": {
    "toggle-eye-protection": {
      "description": "Toggle eye protection mode",
      "suggested_key": {
        "default": "Alt+Shift+Q",
        "mac": "Alt+Shift+Q"
      }
    }
  },
  "content_scripts": [
    {
      "css": [
        "content/styles.css"
      ],
      "js": [
        "js/filter-settings.js",
        "content/content.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start"
    }
  ],
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "128": "icons/icon128.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "minimum_chrome_version": "105",
  "name": "__MSG_extName__",
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "alarms"
  ],
  "version": "1.0.0"
}
